# Telegram bot token (get it from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Trading analysis API — base URL and endpoint
ANALYSE_BASE_URL=http://127.0.0.1:8001
ANALYSE_ENDPOINT=/api/v1/analyse

# Request timeout in seconds (the analysis stack is heavy; allow enough time)
ANALYSE_TIMEOUT=120